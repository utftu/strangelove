{
  "name": "strangelove",
  "version": "2.1.5",
  "type": "module",
  "types": "./dist/types/strangelove.d.ts",
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/strangelove.ts --outdir ./dist --format esm --target browser --minify",
    "build:types": "tsc --project tsconfig.types.json",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "main": "./dist/strangelove.js",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "dapes": "^0.0.37",
    "typescript": "^5.8.2"
  }
}